# 再生成できる生成物だけを無視する（ソースと手作業の素材は追跡する）
out/
*.mp4
# README から参照する動画は追跡する
!docs/media/*.mp4
*.gif
.venv/
__pycache__/
.pytest_cache/
# 論文：PDF は原則コミットする（図の PDF は各 figs/ に，組版済みの本文 PDF は docs/ にコピーして追跡）。
# 無視するのは LaTeX の中間ファイルと，docs/ と重複する作業用の本文 PDF だけ
paper/research/cache/
paper/research/*.aux
paper/research/*.log
paper/research/*.out
paper/research/*.toc
paper/research/*.pdf
# 開発過程の論文（paper/game_dev/）：図の PDF とゲーム画面の切り出し figs/shot_*.png は追跡，本文 PDF は docs/ に置く
paper/game_dev/*.aux
paper/game_dev/*.log
paper/game_dev/*.out
paper/game_dev/*.pdf
# 解説動画（explainer/）：データ・音声・タイムライン・クリップはすべて build.sh で再生成できる
explainer/data/
explainer/manim/media/
explainer/remotion/node_modules/
explainer/remotion/out/
explainer/remotion/public/voice/
explainer/remotion/public/timeline.json
