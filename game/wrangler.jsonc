// Cloudflare Worker config (GAME_DESIGN.md §10.5). Owner: O9.
// database_id: the production D1 "yurapita" (created in the dashboard on 2026-09-23).
// Local development (`wrangler dev`, vitest-pool-workers, `db:migrate:local`) works with the placeholder.
// `wrangler dev` gets DEV=1 from .dev.vars.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yurapita",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yurapita",
      "database_id": "3ff38c9a-64df-481b-9cb8-f2f2371e0e3c",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "RL_SUBMIT", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } },
    { "name": "RL_READ", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  "triggers": { "crons": ["30 15 * * *"] },
  "observability": { "enabled": true },
  "vars": { "DEV": "0", "READ_ONLY": "0" }
}
